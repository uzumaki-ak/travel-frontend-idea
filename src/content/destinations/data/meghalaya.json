  "info": {
    "bestTime": {
      "summary": "Come between October and April for clear skies and easy roads. Come in the monsoon (June to August) for the waterfalls at full power, with some rain on most days.",
      "seasons": [
        {
          "name": "Cool & clear",
          "months": "Oct – Apr",
          "text": "Crisp days, clear rivers at Dawki and the best views from Laitlum. Nights get cold in December and January.",
          "verdict": "best"
        },
        {
          "name": "Shoulder",
          "months": "May & Sep",
          "text": "Fewer visitors and green hills. Showers come and go, so keep a flexible day.",
          "verdict": "good"
        },
        {
          "name": "Monsoon",
          "months": "Jun – Aug",
          "text": "The falls are at their biggest and the clouds sit low. Some roads slow down and the river at Dawki turns murky.",
